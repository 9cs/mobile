<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela 2 - Registrar trilha.
    O mapa ocupa a tela inteira; os painéis ficam sobrepostos a ele.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapa"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Camada dos controles (não intercepta toques: o mapa continua navegável) -->
    <FrameLayout
        android:id="@+id/camada_controles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp">

        <!-- ===== Painel superior: velocidades, distância e cronômetro ===== -->
        <LinearLayout
            android:id="@+id/painel_topo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_painel"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Velocidade instantânea (destaque) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rotulo_velocidade" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_velocidade_atual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            tools:text="0,0"
                            android:textColor="@color/primaria"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/unidade_kmh"
                            android:textColor="@color/texto_secundario"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Modo de navegação e precisão do GPS -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_modo_navegacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingBottom="3dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:text="@string/navegacao_north_up"
                        android:textColor="@color/primaria_escura"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_precisao"
                        style="@style/Texto.Descricao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="10dp"
                android:background="@color/divisor" />

            <!-- Velocidade máxima | Distância | Cronômetro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rotulo_maxima" />

                    <TextView
                        android:id="@+id/tv_velocidade_maxima"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rotulo_distancia" />

                    <TextView
                        android:id="@+id/tv_distancia"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Rotulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rotulo_tempo" />

                    <!-- Cronômetro: tempo desde o início do monitoramento -->
                    <Chronometer
                        android:id="@+id/cronometro"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status"
                style="@style/Texto.Descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/status_aguardando_sinal"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== Parte inferior: centralizar + iniciar/finalizar ===== -->
        <LinearLayout
            android:id="@+id/painel_baixo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_centralizar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_botao_redondo"
                android:contentDescription="@string/centralizar"
                android:elevation="4dp"
                android:src="@drawable/ic_centralizar"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_iniciar_parar"
                style="@style/BotaoPrincipal"
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minWidth="240dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:elevation="4dp"
                android:text="@string/iniciar_trilha" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
