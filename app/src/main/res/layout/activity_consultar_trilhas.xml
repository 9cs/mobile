<?xml version="1.0" encoding="utf-8"?>
<!-- Tela 3 - Consultar trilhas: lista de todas as trilhas registradas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz_consultar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Resumo: quantidade de trilhas e distância total -->
    <TextView
        android:id="@+id/tv_resumo_lista"
        style="@style/Texto.Descricao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lista_trilhas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:listSelector="@android:color/transparent"
            android:padding="14dp"
            android:scrollbarStyle="outsideOverlay" />

        <!-- Exibido quando não há trilhas -->
        <LinearLayout
            android:id="@+id/vazio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.45"
                android:contentDescription="@null"
                android:src="@drawable/ic_trilha_vazia" />

            <TextView
                style="@style/Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lista_vazia_titulo" />

            <TextView
                style="@style/Texto.Descricao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/lista_vazia_texto" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
